import { motion } from "framer-motion";
import { useParams, useNavigate } from "react-router-dom";
import { useAppStore } from "@/stores/appStore";
import { usePortfolio } from "@/hooks/usePortfolio";
import { ChevronLeft, ExternalLink, Star, Bell, Copy, Check } from "lucide-react";
import { useState } from "react";
import { transactions } from "@/data/mockData";

export default function TokenDetail() {
  const { mint } = useParams();
  const navigate = useNavigate();
  const { activeWalletAddress, hideBalances } = useAppStore();
  const { data: portfolio } = usePortfolio(activeWalletAddress || 'demo');
  const [copied, setCopied] = useState(false);

  const token = (portfolio?.tokens || []).find((t: any) => (t.mint || t.symbol) === mint);
  const tokenTxs = transactions.filter(tx => tx.token.includes(token?.symbol || ''));

  const mask = (v: string) => hideBalances ? "••••" : v;

  const handleCopy = (text: string) => {
    navigator.clipboard.writeText(text);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  if (!token) {
    return (
      <div className="page-container">
        <button onClick={() => navigate("/tokens")} className="flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground mb-4">
          <ChevronLeft className="w-4 h-4" /> Back to Tokens
        </button>
        <div className="glass-card p-12 text-center">
          <p className="text-muted-foreground">Token not found.</p>
        </div>
      </div>
    );
  }

  return (
    <div className="page-container">
      <motion.div initial={{ opacity: 0, y: 8 }} animate={{ opacity: 1, y: 0 }} transition={{ duration: 0.35 }} className="space-y-6">
        <button onClick={() => navigate("/tokens")} className="flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground transition-colors">
          <ChevronLeft className="w-4 h-4" /> Tokens
        </button>

        {/* Header */}
        <div className="glass-card p-6">
          <div className="flex items-start justify-between flex-wrap gap-4">
            <div className="flex items-center gap-4">
              <div className="w-14 h-14 rounded-2xl bg-accent flex items-center justify-center text-2xl font-bold text-accent-foreground">
                {token.icon || token.symbol?.[0]}
              </div>
              <div>
                <h1 className="text-2xl font-bold text-foreground">{token.name}</h1>
                <p className="text-sm text-muted-foreground">{token.symbol}</p>
              </div>
            </div>
            <div className="flex items-center gap-2">
              <button className="flex items-center gap-1.5 px-3 py-2 rounded-xl bg-muted/30 text-sm text-muted-foreground hover:text-foreground transition-colors">
                <Star className="w-4 h-4" /> Watchlist
              </button>
              <button className="flex items-center gap-1.5 px-3 py-2 rounded-xl bg-muted/30 text-sm text-muted-foreground hover:text-foreground transition-colors">
                <Bell className="w-4 h-4" /> Alert
              </button>
            </div>
          </div>
        </div>

        {/* Holdings */}
        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
          <div className="glass-card p-5 space-y-1">
            <p className="stat-label">Balance</p>
            <p className="text-xl font-bold text-foreground">{mask((token.balance || 0).toLocaleString())} <span className="text-sm font-normal text-muted-foreground">{token.symbol}</span></p>
          </div>
          <div className="glass-card p-5 space-y-1">
            <p className="stat-label">USD Value</p>
            <p className="text-xl font-bold text-foreground">{mask(`$${(token.value || token.usdValue || 0).toLocaleString('en-US', { minimumFractionDigits: 2 })}`)}</p>
          </div>
          <div className="glass-card p-5 space-y-1">
            <p className="stat-label">Price</p>
            <p className="text-xl font-bold text-foreground">${(token.price || token.pricePerToken || 0) < 0.01 ? (token.price || token.pricePerToken || 0).toFixed(7) : (token.price || token.pricePerToken || 0).toFixed(2)}</p>
          </div>
        </div>

        {/* PnL if available */}
        {token.pnl !== undefined && (
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div className="glass-card p-5 space-y-1">
              <p className="stat-label">Avg Buy Price</p>
              <p className="text-lg font-bold text-foreground">${(token.avgBuyPrice || 0).toFixed(2)}</p>
            </div>
            <div className="glass-card p-5 space-y-1">
              <p className="stat-label">Unrealized PnL</p>
              <p className={`text-lg font-bold ${token.pnl >= 0 ? "text-gain" : "text-loss"}`}>
                {token.pnl >= 0 ? "+" : ""}${Math.abs(token.pnl).toFixed(2)} ({(token.pnlPercent || 0).toFixed(1)}%)
              </p>
            </div>
          </div>
        )}

        {/* Metadata */}
        <div className="glass-card p-6 space-y-3">
          <h3 className="section-title">Token Info</h3>
          <div className="space-y-2">
            {token.mint && (
              <div className="flex items-center justify-between py-2 border-b border-border/30">
                <span className="text-xs text-muted-foreground">Mint Address</span>
                <div className="flex items-center gap-2">
                  <span className="text-xs font-mono text-foreground">{token.mint.slice(0, 8)}...{token.mint.slice(-6)}</span>
                  <button onClick={() => handleCopy(token.mint)} className="p-1 rounded hover:bg-muted/30 transition-colors">
                    {copied ? <Check className="w-3 h-3 text-success" /> : <Copy className="w-3 h-3 text-muted-foreground" />}
                  </button>
                </div>
              </div>
            )}
            <div className="flex items-center justify-between py-2">
              <span className="text-xs text-muted-foreground">Explorer</span>
              <a href={`https://solscan.io/token/${token.mint || ''}`} target="_blank" rel="noreferrer" className="flex items-center gap-1 text-xs text-primary hover:underline">
                View on Solscan <ExternalLink className="w-3 h-3" />
              </a>
            </div>
          </div>
        </div>

        {/* Token Activity */}
        <div className="glass-card p-6">
          <h3 className="section-title mb-4">Activity</h3>
          {tokenTxs.length === 0 ? (
            <div className="py-8 text-center">
              <p className="text-sm text-muted-foreground">No transactions found for this token.</p>
              <p className="text-xs text-muted-foreground mt-1">Activity will appear here as you transact.</p>
            </div>
          ) : (
            <div className="space-y-1">
              {tokenTxs.map(tx => (
                <div key={tx.id} className="flex items-center justify-between py-3 px-2 rounded-xl hover:bg-muted/15 transition-colors">
                  <div>
                    <p className="text-sm font-medium text-foreground capitalize">{tx.type}</p>
                    <p className="text-xs text-muted-foreground">{new Date(tx.date).toLocaleDateString()}</p>
                  </div>
                  <p className="text-sm font-medium text-foreground">{mask(`$${tx.value.toFixed(2)}`)}</p>
                </div>
              ))}
            </div>
          )}
        </div>
      </motion.div>
    </div>
  );
}
